# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=restaurant_user
MYSQL_PASSWORD=restaurant_pass
MYSQL_DATABASE=restaurant_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Default admin (created automatically on first boot if missing)
DEFAULT_ADMIN_EMAIL=admin@restaurant.com
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_NAME=Restaurant Admin
